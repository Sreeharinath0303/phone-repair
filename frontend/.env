# RepairVafe Frontend Environment Variables
# Vite exposes variables prefixed with VITE_ to the client

VITE_APP_NAME=RepairVafe
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Backend API base URL (update when backend is ready)
VITE_API_BASE_URL=http://localhost:5000/api

# App Config
VITE_APP_PORT=3000
VITE_APP_SUPPORT_EMAIL=support@repairvafe.com
VITE_APP_SUPPORT_PHONE=+91 98765 43210
